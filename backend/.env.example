# Copy to .env and replace the example secret before using saved accounts/history.
APP_NAME=BreastCare AI
APP_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./breastcare.db
TOKEN_TTL_HOURS=12
FRONTEND_ORIGIN=http://localhost:5173

# Optional histopathology inference. Use an already-working Python environment;
# this project does not install or pin torch/torchvision.
# RESEARCH_MODEL_PYTHON=C:/absolute/path/to/existing/python.exe
# HISTOPATHOLOGY_CHECKPOINT=../model_artifacts/breakhis/resnet18/<fold-folder>/<checkpoint-file>.pt
